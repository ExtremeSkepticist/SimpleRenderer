<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros">
    <AssimpDllDebug>assimp-vc143-mtd.dll</AssimpDllDebug>
    <AssimpDllRelease>assimp-vc143-mt.dll</AssimpDllRelease>
  </PropertyGroup>
  <PropertyGroup />
  <ItemDefinitionGroup />
  <ItemGroup>
    <BuildMacro Include="AssimpDllDebug">
      <Value>$(AssimpDllDebug)</Value>
    </BuildMacro>
    <BuildMacro Include="AssimpDllRelease">
      <Value>$(AssimpDllRelease)</Value>
    </BuildMacro>
  </ItemGroup>
</Project>